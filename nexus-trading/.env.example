# ======================= NEXUS AI TRADING (.env) ===========================
# Never commit the real .env. All money here is VIRTUAL (paper trading).

DOMAIN=nexus.example.com
POSTGRES_PASSWORD=change-me-long-random

# --- Authentication -------------------------------------------------------
ADMIN_USER=admin
# python -m nexus.cli hash-password   (inside the api container or locally)
ADMIN_PASSWORD_HASH=
# openssl rand -hex 32
JWT_SECRET=

# --- Market data: role -> provider (finnhub | twelvedata | alphavantage | massive | ecb)
QUOTE_PROVIDER=finnhub
HISTORY_PROVIDER=twelvedata
NEWS_PROVIDER=finnhub
FX_PROVIDER=twelvedata
CROSSCHECK_PROVIDER=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
MASSIVE_API_KEY=

# Declare what YOUR plan delivers per market: realtime | delayed | eod | none
# (vendors don't reliably label it in the payload; be conservative)
FINNHUB_ENTITLEMENT=US:realtime,EU:none
TWELVEDATA_ENTITLEMENT=US:realtime,EU:none
ALPHAVANTAGE_ENTITLEMENT=US:delayed,EU:eod
MASSIVE_ENTITLEMENT=US:delayed,EU:none

# --- Data integrity -----------------------------------------------------------
MAX_QUOTE_AGE_SECONDS=120
ALLOW_DELAYED_TRADING=0
MAX_PROVIDER_FAILURES=5

# --- Engine / experiment ------------------------------------------------------
CYCLE_SECONDS=120
CLOSED_CYCLE_SECONDS=900
INITIAL_CAPITAL_EUR=400
AUTO_START_EXPERIMENT=48h
FRACTIONAL_SHARES=1

# --- Paper broker cost model (zero-commission broker + FX fee by default) -----
FEE_FIXED_EUR=0
FEE_PCT=0.0005
FX_FEE_PCT=0.0025
BASE_SLIPPAGE_BPS=5
ORDER_LATENCY_SECONDS=2
ORDER_TTL_MINUTES=60

# --- Optional: Claude for news sentiment only (bounded weight) ----------------
LLM_ENABLED=0
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Alerts (ntfy.sh / Slack / Discord compatible JSON webhook) ----------------
ALERT_WEBHOOK_URL=
